# Copy this file to .env and fill in your values. Never commit .env to GitHub.

# AWS (credentials come from `aws configure`, not from this file)
AWS_REGION=ap-south-1
S3_BUCKET=your-review-insights-bucket

# GenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# How many reviews to send to each LLM (keeps API cost low)
LLM_SAMPLE_SIZE=100
